name: Clip livestream

on:
  workflow_dispatch:
    inputs:
      url:
        description: "YouTube livestream URL"
        required: true
      mode:
        description: "record-ahead or dvr"
        default: "record-ahead"
        type: choice
        options: [record-ahead, dvr]
      seconds:
        description: "Seconds to record (record-ahead mode)"
        default: "60"
      start:
        description: "Start time HH:MM:SS (dvr mode)"
        default: ""
      end:
        description: "End time HH:MM:SS (dvr mode)"
        default: ""
      privacy:
        description: "Video privacy"
        default: "unlisted"
        type: choice
        options: [private, unlisted, public]
  # Optional: uncomment to run on a schedule (UTC). Needs a fixed URL below.
  # schedule:
  #   - cron: "0 * * * *"

jobs:
  clip:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: pip

      - name: Install ffmpeg and Python packages
        run: |
          sudo apt-get update && sudo apt-get install -y ffmpeg
          pip install yt-dlp faster-whisper google-api-python-client google-auth-oauthlib

      - name: Cache Whisper model
        uses: actions/cache@v4
        with:
          path: ~/.cache/huggingface
          key: whisper-base

      - name: Write Google credentials from secrets
        run: |
          echo '${{ secrets.YT_TOKEN_JSON }}' > token.json
          echo '${{ secrets.YT_CLIENT_SECRET_JSON }}' > client_secret.json

      - name: Run clipper
        run: |
          if [ "${{ inputs.mode }}" = "dvr" ]; then
            python livestream_clipper.py "${{ inputs.url }}" \
              --start "${{ inputs.start }}" --end "${{ inputs.end }}" \
              --model base --privacy "${{ inputs.privacy }}"
          else
            python livestream_clipper.py "${{ inputs.url }}" \
              --record-ahead "${{ inputs.seconds }}" \
              --model base --privacy "${{ inputs.privacy }}"
          fi

      - name: Save clip as artifact
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: clips
          path: clips/
          retention-days: 7
